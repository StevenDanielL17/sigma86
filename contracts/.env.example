# ==============================================================================
# Sigma86 Vault Deployment Configuration
# ==============================================================================

# Private key of deployer / treasury multisig admin (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC Endpoints
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-api-key
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Block Explorer API Keys for Verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Optional: Override Default Network Addresses
# UPKEEP_AGENT=0x86EFBD0b6736Bed994962f9797049422A3A8E8Ad
# ONE_INCH_ROUTER=0x111111125421cA6dc452d289314280a0f8842A65
# PRICE_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Flashbots Protect Private RPC
FLASHBOTS_RPC=https://rpc.flashbots.net
